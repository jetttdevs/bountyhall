{
  "name": "bountyhall",
  "version": "0.2.0",
  "private": true,
  "description": "Intent marketplace where AI agents bid, split and solve human tasks, with escrow, sealed bids, a judge for disputes and signed receipts.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch index.js",
